interface Props {
  name: string
  size?: number
  class?: string
}

const { name, size = 16, class: className } = Astro.props
const d = paths[name]

if (!d) {
  throw new Error(
    `starlight-theme-commit-moi: unknown icon "${name}". Add its paths to components/Icon.astro — available: ${Object.keys(paths).join(', ')}.`,
  )
}
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={d}
/>
